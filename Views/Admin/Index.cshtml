@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Course.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["AdminTitle"];
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">@Localizer["AdminTitle"]</h1>
        <p class="text-muted mb-0">@Localizer["PlaceholderTableTitle"]</p>
    </div>
    <div class="btn-toolbar gap-2">
        <button class="btn btn-outline-secondary" type="button">@Localizer["AdminBlock"]</button>
        <button class="btn btn-outline-secondary" type="button">@Localizer["AdminUnblock"]</button>
        <button class="btn btn-outline-danger" type="button">@Localizer["AdminDelete"]</button>
        <button class="btn btn-outline-primary" type="button">@Localizer["AdminToggle"]</button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["TableUser"]</th>
                        <th scope="col">@Localizer["TableEmail"]</th>
                        <th scope="col">@Localizer["TableStatus"]</th>
                        <th scope="col">@Localizer["TableRole"]</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4" class="text-muted">@Localizer["NoUsersLoaded"]</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
