@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Course.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ProfileTitle"];
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-1">@Localizer["ProfileTitle"]</h1>
        <p class="text-muted mb-0">@Localizer["PlaceholderTableTitle"]</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <button class="btn btn-primary mt-2 mt-sm-0" type="button">@Localizer["CreateInventory"]</button>
    }
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">@Localizer["OwnedInventories"]</h2>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["TableTitle"]</th>
                                <th scope="col">@Localizer["TableCategory"]</th>
                                <th scope="col">@Localizer["TableItems"]</th>
                                <th scope="col">@Localizer["TableUpdated"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-muted">@Localizer["NoInventoriesYet"]</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">@Localizer["SharedWithMe"]</h2>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["TableTitle"]</th>
                                <th scope="col">@Localizer["TableOwner"]</th>
                                <th scope="col">@Localizer["TableItems"]</th>
                                <th scope="col">@Localizer["TableUpdated"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-muted">@Localizer["NoSharedInventoriesYet"]</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
