@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="container py-4 fade-in">
    <div class="glass-panel p-4 mb-4 position-relative overflow-hidden">
        <div class="position-absolute top-0 end-0 opacity-10 mt-n4 me-n4">
            <i class="bi bi-gear-fill" style="font-size: 10rem;"></i>
        </div>
        <div class="position-relative z-1">
            <h1 class="h3 mb-1 text-gradient font-accent">Manage your account</h1>
            <p class="text-muted mb-0">Change your account settings</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            <div class="glass-panel p-4 fade-in" style="animation-delay: 0.1s;">
                <div class="row">
                    <div class="col-12">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
