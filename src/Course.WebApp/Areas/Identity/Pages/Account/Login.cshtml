@page
@model LoginModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Course.WebApp.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Login"];
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 glass-card">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-1">@Localizer["Login"]</h2>
                    <p class="text-muted">Sign in to manage your inventories</p>
                </div>

                @if (Model.ExternalLogins?.Count > 0)
                {
                    <div class="external-login-section mb-3">
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            @foreach (var provider in Model.ExternalLogins)
                            {
                                <button type="submit"
                                        class="btn btn-google w-100"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Log in using your @provider.DisplayName account">
                                    @if (provider.DisplayName == "Google")
                                    {
                                        <span class="btn-google__icon-wrapper">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                                <path fill="#4285F4" d="M46.5 24c0-1.55-.15-3.24-.47-4.77H24v9.03h12.75c-.55 3-2.25 5.54-4.81 7.25l7.46 5.78C43.76 37.19 46.5 31.14 46.5 24z"/>
                                                <path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"/>
                                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.46-5.78c-2.2 1.48-5.01 2.39-8.43 2.39-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                            </svg>
                                        </span>
                                    }
                                    <span class="btn-google__text">Continue with @provider.DisplayName</span>
                                </button>
                            }
                        </form>
                    </div>

                    <div class="auth-divider">
                        <span class="auth-divider__text">or sign in with email</span>
                    </div>
                }

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.EmailOrUsername" class="form-control" autocomplete="username" aria-required="true" placeholder="Email or Username" />
                        <label asp-for="Input.EmailOrUsername">Email or Username</label>
                        <span asp-validation-for="Input.EmailOrUsername" class="text-danger text-xs"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger text-xs"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label text-muted" asp-for="Input.RememberMe">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary mb-3">@Localizer["Login"]</button>

                    <div class="text-center">
                        <p class="mb-0 text-muted">
                            Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">@Localizer["Register"]</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
