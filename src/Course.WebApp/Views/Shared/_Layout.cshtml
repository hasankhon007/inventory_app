@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Course.WebApp.SharedResource> Localizer
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var culture = requestCulture?.RequestCulture.UICulture.Name ?? "en";
    var theme = Context.Request.Cookies["theme"] ?? "light";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isDark = string.Equals(theme, "dark", System.StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="@culture" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["AppName"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Course.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["AppName"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["NavHome"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inventories" asp-action="Index">@Localizer["NavInventories"]</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Profile" asp-action="Index">@Localizer["NavMyPage"]</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">@Localizer["NavAdmin"]</a>
                            </li>
                        }
                    </ul>
                    <form class="d-flex flex-grow-1 flex-sm-grow-0 me-2" asp-controller="Search" asp-action="Index" method="get" role="search">
                        <input class="form-control form-control-sm me-2" type="search" name="q" value="@Context.Request.Query["q"]"
                               placeholder="@Localizer["SearchPlaceholder"]" aria-label="@Localizer["SearchPlaceholder"]" />
                        <button class="btn btn-primary btn-sm d-flex align-items-center" type="submit" aria-label="@Localizer["SearchButton"]">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search me-2" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242 1.156a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/>
                            </svg>
                            <span class="d-none d-sm-inline">@Localizer["SearchButton"]</span>
                        </button>
                    </form>
                    <div class="d-flex align-items-center gap-2">
                        <button id="theme-toggle" class="btn btn-outline-primary btn-sm" type="button" data-theme="@(isDark ? "dark" : "light")"
                                data-label-light="@Localizer["ThemeLight"]" data-label-dark="@Localizer["ThemeDark"]">
                            @(isDark ? Localizer["ThemeLight"] : Localizer["ThemeDark"])
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @Localizer["Language"]
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <form asp-controller="Preferences" asp-action="Language" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="en" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="dropdown-item" type="submit">English</button>
                                </form>
                                <form asp-controller="Preferences" asp-action="Language" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="uz" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="dropdown-item" type="submit">Uzbek</button>
                                </form>
                            </div>
                        </div>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-shell">
        <main role="main" class="app-main pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @Localizer["AppName"] - <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["PrivacyTitle"]</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
