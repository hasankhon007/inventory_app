@using Microsoft.Extensions.Localization
@model List<Course.Services.DTOs.UserListItemDto>
@inject IStringLocalizer<Course.WebApp.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["AdminTitle"];
}

<div class="glass-panel p-4 mb-4 fade-in">
    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
        <div>
            <h1 class="h3 mb-1 text-gradient font-accent">@Localizer["AdminTitle"]</h1>
            <p class="text-muted mb-0">Manage system users, adjust roles, and enforce security policies.</p>
        </div>
        <div class="stats-badge px-3 py-2 rounded-pill">
            <span class="fw-bold">@Model.Count</span> Users Registered
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm glass-alert mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Success:" fill="currentColor" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            <div>@TempData["SuccessMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm glass-alert mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Danger:" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <div>@TempData["ErrorMessage"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="glass-panel overflow-hidden fade-in" style="animation-delay: 0.1s;">
    <div class="table-responsive">
        <table class="table align-middle custom-table mb-0">
            <thead>
                <tr>
                    <th scope="col" class="ps-4">@Localizer["TableUser"]</th>
                    <th scope="col">@Localizer["TableEmail"]</th>
                    <th scope="col">@Localizer["TableRole"]</th>
                    <th scope="col">@Localizer["TableStatus"]</th>
                    <th scope="col" class="pe-4 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <div class="d-flex flex-column align-items-center gap-2">
                                <i class="bi bi-people-fill fs-1 text-muted opacity-50"></i>
                                <span>@Localizer["NoUsersLoaded"]</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        var isCurrentAdmin = User.Identity?.Name == user.Email;
                        var initials = !string.IsNullOrEmpty(user.FullName) 
                            ? string.Concat(user.FullName.Split(' ').Select(s => s.FirstOrDefault())).ToUpper()
                            : user.Email?.FirstOrDefault().ToString().ToUpper() ?? "U";
                        if (initials.Length > 2) initials = initials.Substring(0, 2);

                        <tr class="table-row-hover">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle">
                                        @initials
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@(user.FullName ?? "No Name Provided")</div>
                                        <small class="text-muted d-sm-none">@user.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted fs-7">@user.Email</span>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @foreach (var role in user.Roles)
                                    {
                                        var badgeClass = role == "Admin" ? "badge-admin" : "badge-user";
                                        <span class="badge @badgeClass">@role</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (user.IsBlocked)
                                {
                                    <span class="badge badge-blocked">
                                        <span class="status-dot status-dot-blocked"></span> Blocked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-active">
                                        <span class="status-dot status-dot-active"></span> Active
                                    </span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex gap-2">
                                    @if (!isCurrentAdmin)
                                    {
                                        <!-- Toggle Role Button -->
                                        <form asp-action="ToggleRole" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-action-secondary" title="@Localizer["AdminToggle"]">
                                                <i class="bi bi-shield-shaded"></i> Toggle Role
                                            </button>
                                        </form>

                                        <!-- Block/Unblock Button -->
                                        <form asp-action="@(user.IsBlocked ? "UnblockUser" : "BlockUser")" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.IsBlocked)
                                            {
                                                <button type="submit" class="btn btn-action-success" title="@Localizer["AdminUnblock"]">
                                                    <i class="bi bi-unlock-fill"></i> Unblock
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-action-warning" title="@Localizer["AdminBlock"]">
                                                    <i class="bi bi-lock-fill"></i> Block
                                                </button>
                                            }
                                        </form>

                                        <!-- Delete Button -->
                                        <form asp-action="DeleteUser" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user? This will also cascade delete all their inventories and items.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-action-danger" title="@Localizer["AdminDelete"]">
                                                <i class="bi bi-trash3-fill"></i> Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8 italic-text pe-2">Self (Protected)</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

