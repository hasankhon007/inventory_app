@using Course.WebApp.ViewModels
@using Course.Domain.Enums
@using Microsoft.Extensions.Localization
@model Course.WebApp.ViewModels.InventoryItemEditViewModel
@inject IStringLocalizer<Course.WebApp.SharedResource> Localizer
@{
    ViewData["Title"] = $"{Model.Nav.Title} - Edit Item";
}

@await Html.PartialAsync("_InventoryMenu", Model.Nav)

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h5">Edit Item</h1>
                <form asp-action="EditItem" asp-route-id="@Model.InventoryId" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="InventoryId" />
                    <input type="hidden" asp-for="ItemId" />

                    @* ===== Fixed Fields ===== *@
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">@Localizer["ItemNameLabel"] <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">@Localizer["DescriptionLabel"] <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">@Localizer["PriceLabel"] <span class="text-danger">*</span></label>
                        <input asp-for="Price" class="form-control" type="number" step="any" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    @* ===== Dynamic Custom Fields ===== *@
                    @if (Model.FieldDefinitions.Count > 0)
                    {
                        <hr class="my-4" />
                        <h2 class="h6">@Localizer["ItemFieldsTitle"]</h2>

                        @foreach (var field in Model.FieldDefinitions)
                        {
                            var fieldKey = field.CustomFieldId.ToString();
                            var existingValue = Model.FieldValues.TryGetValue(fieldKey, out var v) ? v : field.Value;
                            var requiredAttr = field.IsRequired ? "required" : "";

                            <div class="mb-3">
                                @if (field.FieldType == InventoryFieldType.Boolean)
                                {
                                    <div class="form-check">
                                        <input type="checkbox"
                                               name="FieldValues[@fieldKey]"
                                               value="true"
                                               class="form-check-input"
                                               id="field_@fieldKey"
                                               @(existingValue == "True" || existingValue == "true" || existingValue == "1" ? "checked" : "") />
                                        <input type="hidden" name="FieldValues[@fieldKey]" value="false" />
                                        <label class="form-check-label" for="field_@fieldKey">
                                            @field.Name
                                            @if (field.IsRequired) { <span class="text-danger">*</span> }
                                        </label>
                                    </div>
                                }
                                else if (field.FieldType == InventoryFieldType.SingleLineText)
                                {
                                    <label class="form-label" for="field_@fieldKey">
                                        @field.Name
                                        @if (field.IsRequired) { <span class="text-danger">*</span> }
                                    </label>
                                    <input type="text"
                                           name="FieldValues[@fieldKey]"
                                           value="@existingValue"
                                           class="form-control"
                                           id="field_@fieldKey"
                                           @requiredAttr />
                                }
                                else if (field.FieldType == InventoryFieldType.MultiLineText)
                                {
                                    <label class="form-label" for="field_@fieldKey">
                                        @field.Name
                                        @if (field.IsRequired) { <span class="text-danger">*</span> }
                                    </label>
                                    <textarea name="FieldValues[@fieldKey]"
                                              class="form-control"
                                              id="field_@fieldKey"
                                              rows="3"
                                              @requiredAttr>@existingValue</textarea>
                                }
                                else if (field.FieldType == InventoryFieldType.Number)
                                {
                                    <label class="form-label" for="field_@fieldKey">
                                        @field.Name
                                        @if (field.IsRequired) { <span class="text-danger">*</span> }
                                    </label>
                                    <input type="number"
                                           name="FieldValues[@fieldKey]"
                                           value="@existingValue"
                                           class="form-control"
                                           id="field_@fieldKey"
                                           step="any"
                                           @requiredAttr />
                                }
                                else if (field.FieldType == InventoryFieldType.Url || field.FieldType == InventoryFieldType.Link)
                                {
                                    <label class="form-label" for="field_@fieldKey">
                                        @field.Name
                                        @if (field.IsRequired) { <span class="text-danger">*</span> }
                                    </label>
                                    <input type="url"
                                           name="FieldValues[@fieldKey]"
                                           value="@existingValue"
                                           class="form-control"
                                           id="field_@fieldKey"
                                           @requiredAttr />
                                }
                                else if (field.FieldType == InventoryFieldType.OneFromList)
                                {
                                    <label class="form-label" for="field_@fieldKey">
                                        @field.Name
                                        @if (field.IsRequired) { <span class="text-danger">*</span> }
                                    </label>
                                    <select name="FieldValues[@fieldKey]"
                                            class="form-select"
                                            id="field_@fieldKey"
                                            @requiredAttr>
                                        <option value="">-- Select --</option>
                                        @if (field.SelectOptions != null)
                                        {
                                            foreach (var option in field.SelectOptions)
                                            {
                                                <option value="@option" selected="@(existingValue == option)">@option</option>
                                            }
                                        }
                                    </select>
                                }
                            </div>
                        }
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a class="btn btn-outline-secondary" asp-action="Items" asp-route-id="@Model.InventoryId">@Localizer["InventoryItems"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
