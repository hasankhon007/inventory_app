@using Microsoft.Extensions.Localization
@model Course.WebApp.ViewModels.InventoryFieldsViewModel
@inject IStringLocalizer<Course.WebApp.SharedResource> Localizer
@{
    ViewData["Title"] = $"{Model.Nav.Title} - {Localizer["InventoryFields"]}";
}

@await Html.PartialAsync("_InventoryMenu", Model.Nav)

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h5">@Localizer["InventoryFields"]</h1>
        @if (TempData["FieldError"] is string fieldError)
        {
            <div class="alert alert-danger">@fieldError</div>
        }

        @* ===== Add Field Form ===== *@
        <form asp-action="AddField" asp-route-id="@Model.Nav.InventoryId" method="post" class="row g-3 mb-4">
            @Html.AntiForgeryToken()
            <div class="col-12 col-md-2">
                <select name="FieldType" class="form-select">
                    <option value="SingleLineText">Single line</option>
                    <option value="MultiLineText">Multi line</option>
                    <option value="Number">Number</option>
                    <option value="Boolean">Boolean</option>
                    <option value="Url">URL</option>
                    <option value="OneFromList">Select (One from list)</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <input name="Name" class="form-control" placeholder="Field Name" required />
            </div>
            <div class="col-12 col-md-1 form-check pt-2">
                <input type="checkbox" name="IsRequired" value="true" class="form-check-input" id="isRequiredAdd" />
                <label class="form-check-label" for="isRequiredAdd">Required</label>
            </div>
            <div class="col-12 col-md-3">
                <input name="SettingsJson" class="form-control" placeholder='Settings JSON (optional)' />
            </div>
            <div class="col-12 col-md-1">
                <input name="DisplayOrder" class="form-control" type="number" placeholder="Order" />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <button class="btn btn-primary" type="submit">@Localizer["AddField"]</button>
            </div>
        </form>

        <div class="mb-3">
            <small class="text-muted">
                <strong>SettingsJson examples:</strong>
                <code>{"MinLength":3,"MaxLength":100}</code> |
                <code>{"MinValue":0,"MaxValue":999}</code> |
                <code>{"Regex":"^[A-Z]{2}\\d+$"}</code> |
                <code>{"Options":["New","Used","Refurbished"]}</code>
            </small>
        </div>

        @* ===== Field List ===== *@
        <div class="table-responsive">
            <table class="table align-middle custom-table">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["TableTitle"]</th>
                        <th scope="col">@Localizer["TableFieldType"]</th>
                        <th scope="col">Required</th>
                        <th scope="col">Order</th>
                        <th scope="col">Settings</th>
                        <th scope="col">Created</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Fields.Count > 0)
                    {
                        foreach (var field in Model.Fields)
                        {
                            <tr>
                                <td colspan="7">
                                    <form asp-action="UpdateField" asp-route-id="@Model.Nav.InventoryId" method="post" class="row g-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@field.Id" />
                                        <div class="col-12 col-md-2">
                                            <input name="Name" class="form-control" value="@field.Name" />
                                        </div>
                                        <div class="col-12 col-md-2">
                                            <select name="FieldType" class="form-select">
                                                <option value="SingleLineText" selected="@(field.FieldType == Course.Domain.Enums.InventoryFieldType.SingleLineText)">Single line</option>
                                                <option value="MultiLineText" selected="@(field.FieldType == Course.Domain.Enums.InventoryFieldType.MultiLineText)">Multi line</option>
                                                <option value="Number" selected="@(field.FieldType == Course.Domain.Enums.InventoryFieldType.Number)">Number</option>
                                                <option value="Boolean" selected="@(field.FieldType == Course.Domain.Enums.InventoryFieldType.Boolean)">Boolean</option>
                                                <option value="Url" selected="@(field.FieldType == Course.Domain.Enums.InventoryFieldType.Url)">URL</option>
                                                <option value="OneFromList" selected="@(field.FieldType == Course.Domain.Enums.InventoryFieldType.OneFromList)">Select</option>
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-1 form-check">
                                            <input type="checkbox" name="IsRequired" value="true" class="form-check-input" @(field.IsRequired ? "checked" : "") />
                                            <input type="hidden" name="IsRequired" value="false" />
                                        </div>
                                        <div class="col-12 col-md-1">
                                            <input name="DisplayOrder" class="form-control" type="number" value="@field.DisplayOrder" />
                                        </div>
                                        <div class="col-12 col-md-2">
                                            <input name="SettingsJson" class="form-control" value="@field.SettingsJson" placeholder="Settings JSON" />
                                        </div>
                                        <div class="col-12 col-md-1 text-muted">
                                            @field.CreatedAt.ToLocalTime().ToString("d")
                                        </div>
                                        <div class="col-12 col-md-2 d-flex gap-2 justify-content-end">
                                            <button class="btn btn-primary btn-sm" type="submit">@Localizer["SaveChanges"]</button>
                                            <button class="btn btn-action-danger btn-sm" type="submit" formaction="@Url.Action("RemoveField", new { id = Model.Nav.InventoryId, fieldId = field.Id })">@Localizer["AdminDelete"]</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-muted">@Localizer["NoFieldsYet"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
