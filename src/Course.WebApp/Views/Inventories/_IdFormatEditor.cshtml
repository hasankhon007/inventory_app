@model string
@{
    var inputName = ViewData["InputName"] as string ?? "IdFormat";
    var inputId = ViewData["InputId"] as string ?? "idFormatInput";
    var previewBtnId = inputId + "_previewBtn";
    var previewResultId = inputId + "_previewResult";
}
<div class="mb-3 id-format-editor p-3 rounded-4 border">
    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-2">
        <label class="form-label mb-0" for="@inputId">ID format</label>
        <span class="badge bg-secondary-subtle text-secondary-emphasis">Smart preview</span>
    </div>
    <div class="input-group">
        <input id="@inputId" name="@inputName" class="form-control form-control-lg" value="@Model" maxlength="200" />
        <button type="button" id="@previewBtnId" class="btn btn-outline-secondary">Preview</button>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3 small text-muted">
        <span>Use tokens like</span>
        <code>{SEQ:0000}</code>
        <code>{DATE:yyyyMMdd}</code>
        <code>{RAND32:X8}</code>
        <code>{GUID}</code>
    </div>
    <div class="mt-3 d-flex align-items-center gap-2">
        <strong>Example:</strong> <span id="@previewResultId" class="font-monospace">-</span>
    </div>
</div>
<script src="/js/inventory-id-editor.js"></script>
<script>if(window.InventoryIdEditor){InventoryIdEditor.init({inputId:'@inputId', previewBtnId:'@previewBtnId', previewResultId:'@previewResultId'});}</script>
